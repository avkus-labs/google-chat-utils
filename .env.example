# === Google Chat Utils Environment Variables ===

# LLM Distillation API (OpenAI-compatible)
DISTILL_BASE_URL=https://api.openai.com/v1
DISTILL_MODEL=gpt-4o
DISTILL_SYNTHESIS_MODEL=gpt-4o
DISTILL_API_KEY=your_distill_api_key_here

# Google Drive Integration (Task 002)
GDRIVE_CLIENT_ID=your_gdrive_client_id_here
GDRIVE_CLIENT_SECRET=your_gdrive_client_secret_here
GDRIVE_REFRESH_TOKEN=your_gdrive_refresh_token_here
