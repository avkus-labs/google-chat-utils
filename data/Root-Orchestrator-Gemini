ct:\n    \"\"\"\n    Извлекает response_mime_type и response_schema (как dict) из generate_content_config.\n    \"\"\"\n    tree \u003d ast.parse(chat_code)\n    result \u003d {}\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Assign):\n            for target in node.targets:\n                if isinstance(target, ast.Name) and target.id \u003d\u003d \u0027generate_content_config\u0027:\n                    if isinstance(node.value, ast.Call):\n                        for kw in node.value.keywords:\n                            if kw.arg \u003d\u003d \u0027response_mime_type\u0027 and isinstance(kw.value, ast.Constant):\n                                result[\u0027response_mime_type\u0027] \u003d kw.value.value\n                            if kw.arg \u003d\u003d \u0027response_schema\u0027:\n                                result[\u0027response_schema\u0027] \u003d ast_to_schema_dict(kw.value)\n    return result\n\n\ndef ast_to_schema_dict(node) -\u003e Any:\n    \"\"\"\n    Рекурсивно преобразует AST-узел types.Schema(...) в dict (JSON Schema).\n    \"\"\"\n    if isinstance(node, ast.Call) and hasattr(node.func, \u0027attr\u0027) and node.func.attr \u003d\u003d \u0027Schema\u0027:\n        schema \u003d {}\n        for kw in node.keywords:\n            if kw.arg \u003d\u003d \u0027type\u0027:\n                if isinstance(kw.value, ast.Attribute):\n                    schema[\u0027type\u0027] \u003d type_attr_to_str(kw.value)\n            elif kw.arg \u003d\u003d \u0027properties\u0027:\n                if isinstance(kw.value, ast.Dict):\n                    props \u003d {}\n                    for k, v in zip(kw.value.keys, kw.value.values):\n                        if isinstance(k, ast.Constant):\n                            props[k.value] \u003d ast_to_schema_dict(v)\n                    schema[\u0027properties\u0027] \u003d props\n            elif kw.arg \u003d\u003d \u0027enum\u0027:\n                if isinstance(kw.value, ast.List):\n                    schema[\u0027enum\u0027] \u003d [elt.value for elt in kw.value.elts if isinstance(elt, ast.Constant)]\n        return schema\n    return None\n\n\ndef type_attr_to_str(attr_node) -\u003e str:\n    # Преобразует genai.types.Type.STRING -\u003e \u0027string\u0027, и т.д.\n    mapping \u003d {\n        \u0027STRING\u0027: \u0027string\u0027,\n        \u0027NUMBER\u0027: \u0027number\u0027,\n        \u0027INTEGER\u0027: \u0027integer\u0027,\n        \u0027BOOLEAN\u0027: \u0027boolean\u0027,\n        \u0027OBJECT\u0027: \u0027object\u0027,\n    }\n    if isinstance(attr_node, ast.Attribute):\n        return mapping.get(attr_node.attr, attr_node.attr.lower())\n    return \u0027unknown\u0027\n\n\ndef extract_dialogue_history(chat_code: str) -\u003e List[Dict[str, Any]]:\n    tree \u003d ast.parse(chat_code)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Assign):\n            for target in node.targets:\n                if isinstance(target, ast.Name) and target.id \u003d\u003d \u0027contents\u0027:\n                    if isinstance(node.value, ast.List):\n                        dialogue \u003d []\n                        for elt in node.value.elts:\n                            if isinstance(elt, ast.Call):\n                                role \u003d None\n                                parts \u003d []\n                                for kw in elt.keywords:\n                                    if kw.arg \u003d\u003d \u0027role\u0027 and isinstance(kw.value, ast.Constant):\n                                        role \u003d kw.value.value\n                                    if kw.arg \u003d\u003d \u0027parts\u0027 and isinstance(kw.value, ast.List):\n                                        for part_elt in kw.value.elts:\n                                            if isinstance(part_elt, ast.Call):\n                                                # from_text\n                                                if hasattr(part_elt.func, \u0027attr\u0027) and part_elt.func.attr \u003d\u003d \u0027from_text\u0027:\n                                                    text_val \u003d None\n                                                    for arg in part_elt.args:\n                                                        if isinstance(arg, ast.Constant):\n                                                            text_val \u003d arg.value\n                                                    for kwarg in part_elt.keywords:\n                                                        if kwarg.arg \u003d\u003d \u0027text\u0027 and isinstance(kwarg.value, ast.Constant):\n                                                            text_val \u003d kwarg.value.value\n                                                    if text_val is not None:\n                                                        parts.append({\u0027text\u0027: text_val})\n                                                # from_bytes\n                                                elif hasattr(part_elt.func, \u0027attr\u0027) and part_elt.func.attr \u003d\u003d \u0027from_bytes\u0027:\n                                                    mime_type \u003d None\n                                                    base64_data \u003d None\n                                                    for kwarg in part_elt.keywords:\n                                                        if kwarg.arg \u003d\u003d \u0027mime_type\u0027 and isinstance(kwarg.value, ast.Constant):\n                                                            mime_type \u003d kwarg.value.value\n                                                        if kwarg.arg \u003d\u003d \u0027data\u0027:\n                                                            # data\u003dbase64.b64decode(\"...\"), ищем строку\n                                                            if isinstance(kwarg.value, ast.Call) and hasattr(kwarg.value.func, \u0027attr\u0027) and kwarg.value.func.attr \u003d\u003d \u0027b64decode\u0027:\n                                                                for arg in kwarg.value.args:\n                                                                    if isinstance(arg, ast.Constant):\n                                                                        base64_data \u003d arg.value\n                                                    if mime_type and base64_data:\n                                                        parts.append({\u0027mime_type\u0027: mime_type, \u0027base64_data\u0027: base64_data})\n                                if role \u003d\u003d \u0027user\u0027:\n                                    dialogue.append({\u0027role\u0027: \u0027user\u0027, \u0027parts\u0027: parts})\n                                elif role \u003d\u003d \u0027model\u0027:\n                                    dialogue.append({\u0027role\u0027: \u0027model\u0027, \u0027parts\u0027: parts})\n                        return dialogue\n    return []\n\n```\n\nЧасть 1 реализована:\n\n- **extract_dialogue_history** теперь поддерживает мультимодальные сообщения (`types.Part.from_bytes`), корректно извлекает mime_type и base64_data.\n- **extract_generation_config_details** извлекает `response_mime_type` и рекурсивно парсит `response_schema` в dict (JSON Schema).\n- Вся вложенность и типы данных схемы поддерживаются (string, number, integer, boolean, object, enum).\n\n---\n\n**Следующий шаг:**  \n- extract_tools_info: поддержка function_declarations, code_execution, url_context, google_search.\n- format_for_json/format_for_rag: новые поля, схемы как блоки json в Markdown, инструменты — только заглушка.\n\nПерейти к следующей части?\n\n---\n\n**User**\n\nПерейти к следующей части\n\n---\n\n**Cursor**\n\n```python\n# ... существующий импорт ...\n\ndef extract_tools_info(chat_code: str) -\u003e Optional[List[Dict[str, Any]]]:\n    \"\"\"\n    Извлекает информацию об инструментах (tools) из кода чата, включая function_declarations и code_execution.\n    \"\"\"\n    tree \u003d ast.parse(chat_code)\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Assign):\n            for target in node.targets:\n                if isinstance(target, ast.Name) and target.id \u003d\u003d \u0027tools\u0027:\n                    if isinstance(node.value, ast.List):\n                        tools \u003d []\n                        for elt in node.value.elts:\n                            if isinstance(elt, ast.Call):\n                                # function_declarations\n                                for kw in elt.keywords:\n                                    if kw.arg \u003d\u003d \u0027function_declarations\u0027 and isinstance(kw.value, ast.List):\n                                        functions \u003d []\n                                        for func_decl in kw.value.elts:\n                                            if isinstance(func_decl, ast.Call):\n                                                func_info \u003d {}\n                                                for fkw in func_decl.keywords:\n                                                    if fkw.arg \u003d\u003d \u0027name\u0027 and isinstance(fkw.value, ast.Constant):\n                                                        func_info[\u0027name\u0027] \u003d fkw.value.value\n                                                    if fkw.arg \u003d\u003d \u0027description\u0027 and isinstance(fkw.value, ast.Constant):\n                                                        func_info[\u0027description\u0027] \u003d fkw.value.value\n                                                    if fkw.arg \u003d\u003d \u0027parameters\u0027:\n                                                        func_info[\u0027parameters\u0027] \u003d ast_to_schema_dict(fkw.value)\n                                                functions.append(func_info)\n                                        tools.append({\u0027type\u0027: \u0027function_declaration\u0027, \u0027functions\u0027: functions})\n                                    elif kw.arg \u003d\u003d \u0027code_execution\u0027:\n                                        tools.append({\u0027type\u0027: \u0027code_execution\u0027})\n                                    elif kw.arg \u003d\u003d \u0027url_context\u0027:\n                                        tools.append({\u0027type\u0027: \u0027url_context\u0027})\n                                    elif kw.arg \u003d\u003d \u0027google_search\u0027:\n                                        tools.append({\u0027type\u0027: \u0027google_search\u0027})\n                        return tools if tools else None\n    return None\n\n\ndef format_for_json(system_instruction: str, dialogue_history: List[Dict[str, Any]], tools_info: Optional[List[Dict[str, Any]]], response_mime_type: Optional[str], response_schema: Optional[dict]) -\u003e str:\n    data \u003d {\n        \"system_instruction\": system_instruction,\n        \"tools_info\": tools_info if tools_info else None,\n        \"dialogue_history\": dialogue_history,\n        \"response_mime_type\": response_mime_type,\n        \"response_schema\": response_schema\n    }\n    return json.dumps(data, ensure_ascii\u003dFalse, indent\u003d2)\n\n\ndef format_for_rag(system_instruction: str, dialogue_history: List[Dict[str, Any]], tools_info: Optional[List[Dict[str, Any]]], response_mime_type: Optional[str], response_schema: Optional[dict]) -\u003e str:\n    md \u003d []\n    md.append(f\"\u003csystem_instruction\u003e\\n{system_instruction}\\n\u003c/system_instruction\u003e\\n\")\n    # Инструменты — только заглушка\n    if tools_info:\n        md.append(\"\u003ctools_placeholder\u003e\\n  В этом чате использовались инструменты (function calling, code execution или другие). Для подробностей см. исходный код чата.\\n\u003c/tools_placeholder\u003e\\n\")\n    # response_mime_type\n    if response_mime_type:\n        md.append(f\"\u003cresponse_mime_type\u003e{response_mime_type}\u003c/response_mime_type\u003e\\n\")\n    # response_schema — как блок json\n    if response_schema:\n        md.append(\"\u003cresponse_schema_definition\u003e\\n```json\")\n        md.append(json.dumps(response_schema, ensure_ascii\u003dFalse, indent\u003d2))\n        md.append(\"```\\n\u003c/response_schema_definition\u003e\\n\")\n    md.append(\"\u003cdialogue_history\u003e\")\n    for turn in dialogue_history:\n        role \u003d turn[\u0027role\u0027]\n        md.append(f\"  \u003cturn role\u003d\\\"{role}\\\"\u003e\")\n        for part in turn[\u0027parts\u0027]:\n            # from_text\n            if \u0027text\u0027 in part:\n                md.append(f\"    \u003cmessage_text\u003e{part[\u0027text\u0027]}\u003c/message_text\u003e\")\n            # from_bytes (мультимодальные)\n            if \u0027mime_type\u0027 in part and \u0027base64_data\u0027 in part:\n                if part[\u0027mime_type\u0027].startswith(\u0027image/\u0027):\n                    md.append(f\u0027    \u003cimage_placeholder mime_type\u003d\"{part[\"mime_type\"]}\" description\u003d\"Base64 data of an image was here\"/\u003e\u0027)\n                else:\n                    md.append(f\u0027    \u003cbinary_placeholder mime_type\u003d\"{part[\"mime_type\"]}\" description\u003d\"Base64 data of a binary file was here\"/\u003e\u0027)\n        md.append(f\"  \u003c/turn\u003e\")\n    md.append(\"\u003c/dialogue_history\u003e\")\n    return \u0027\\n\u0027.join(md)\n\n```\n\nВторая часть готова:\n\n- **extract_tools_info** теперь поддерживает function_declarations, code_execution, url_context, google_search.\n- **format_for_json** и **format_for_rag**:\n    - В JSON — все детали инструментов, схем, mime_type.\n    - В Markdown — инструменты только как заглушка `\u003ctools_placeholder\u003e...`, схемы как блоки ```json ... ```.\n    - Мультимодальные сообщения отображаются плейсхолдерами.\n\n**Следующий шаг:**  \n- Обновить main для передачи response_mime_type и response_schema.\n- Перейти к доработке reconstructor.py (рекурсивная генерация кода для схем, поддержка всех типов инструментов, мультимодальных сообщений).\n\nПродолжить?\n\n---\n\n**User**\n\nПродолжить\n\n---\n\n**Cursor**\n\nПереходим к доработке `reconstructor.py`:\n\n**План:**\n1. **reconstruct_contents_list**:\n    - Поддержка мультимодальных сообщений: если part содержит `mime_type` и `base64_data`, генерировать `types.Part.from_bytes(mime_type\u003d..., data\u003dbase64.b64decode(...))`.\n    - Если part содержит `text`, `thoughts`, `response_text` — как раньше.\n\n2. **reconstruct_tools_list**:\n    - Если tool type \u003d\u003d function_declaration:\n        - Для каждой функции: генерировать `types.FunctionDeclaration(...)` с параметрами через рекурсивную функцию для схемы.\n    - Если tool type \u003d\u003d code_execution: генерировать `types.Tool(code_execution\u003dtypes.ToolCodeExecution)`.\n    - Для других инструментов — как раньше.\n\n3. **Рекурсивная функция для генерации types.Schema(...) из JSON-схемы**.\n\n4. **main_reconstruct/generate_python_chat_code**:\n    - Поддержка новых плейсхолдеров: response_mime_type, response_schema_code.\n    - Вставка response_schema только если есть и mime_type \u003d\u003d application/json.\n\n5. **Шаблон**:\n    - Обновить шаблон для поддержки новых плейсхолдеров.\n\n---\n\nСейчас реализую эти изменения в `reconstructor.py`.\n\n```python\nimport argparse\nimport json\nimport base64\nfrom typing import List, Dict, Any, Optional\n\n\ndef load_json_data(file_path: str) -\u003e dict:\n    with open(file_path, \u0027r\u0027, encoding\u003d\u0027utf-8\u0027) as f:\n        return json.load(f)\n\n\ndef reconstruct_contents_list(dialogue_history: List[Dict[str, Any]], decode_unicode: bool \u003d False) -\u003e str:\n    parts_code_list \u003d []\n    base_indent \u003d \"        \"  # 8 пробелов\n    part_indent \u003d \"            \"  # 12 пробелов\n    text_indent \u003d \"                \"  # 16 пробелов\n\n    for turn in dialogue_history:\n        role_str \u003d f\u0027{base_indent}types.Content(\\n{part_indent}role\u003d\"{turn[\"role\"]}\",\\n{part_indent}parts\u003d[\\n\u0027\n        part_texts \u003d []\n        for part_dict in turn[\u0027parts\u0027]:\n            # from_bytes\n            if \u0027mime_type\u0027 in part_dict and \u0027base64_data\u0027 in part_dict:\n                part_texts.append(f\u0027{text_indent}types.Part.from_bytes(mime_type\u003d{repr(part_dict[\"mime_type\"])},\u0027\n                                 f\u0027 data\u003dbase64.b64decode({repr(part_dict[\"base64_data\"])}))\u0027)\n            # from_text\n            elif \u0027text\u0027 in part_dict:\n                text \u003d part_dict[\u0027text\u0027]\n                if decode_unicode:\n                    part_texts.append(f\u0027{text_indent}types.Part.from_text(text\u003d{repr(text)})\u0027)\n                else:\n                    escaped \u003d json.dumps(text)[1:-1]\n                    part_texts.append(f\u0027{text_indent}types.Part.from_text(text\u003d\"\"\"{escaped}\"\"\")\u0027)\n        role_str +\u003d \u0027,\\n\u0027.join(part_texts)\n        role_str +\u003d f\"\\n{part_indent}]\\n{base_indent})\"\n        parts_code_list.append(role_str)\n    return \u0027,\\n\u0027.join(parts_code_list)\n\n\ndef schema_json_to_code(schema: dict, indent: str \u003d \"\") -\u003e str:\n    \"\"\"\n    Рекурсивно генерирует код types.Schema(...) из JSON-схемы.\n    \"\"\"\n    type_map \u003d {\n        \u0027string\u0027: \u0027genai.types.Type.STRING\u0027,\n        \u0027number\u0027: \u0027genai.types.Type.NUMBER\u0027,\n        \u0027integer\u0027: \u0027genai.types.Type.INTEGER\u0027,\n        \u0027boolean\u0027: \u0027genai.types.Type.BOOLEAN\u0027,\n        \u0027object\u0027: \u0027genai.types.Type.OBJECT\u0027,\n    }\n    args \u003d []\n    if \u0027type\u0027 in schema:\n        args.append(f\u0027type\u003d{type_map.get(schema[\"type\"], repr(schema[\"type\"]))}\u0027)\n    if \u0027properties\u0027 in schema:\n        props \u003d []\n        for k, v in schema[\u0027properties\u0027].items():\n            props.append(f\u0027{repr(k)}: {schema_json_to_code(v, indent + \"    \")}\u0027)\n        args.append(f\u0027properties\u003d{{\\n{indent}    \u0027 + \u0027,\\n\u0027.join(props) + f\u0027\\n{indent}}}\u0027)\n    if \u0027enum\u0027 in schema:\n        args.append(f\u0027enum\u003d{repr(schema[\"enum\"])}\u0027)\n    return f\u0027genai.types.Schema({\", \".join(args)})\u0027\n\n\ndef reconstruct_tools_list(tools_info: Optional[List[Dict[str, Any]]]) -\u003e Optional[str]:\n    if not tools_info:\n        return None\n    tool_lines \u003d []\n    base_indent \u003d \"        \"\n    for tool in tools_info:\n        t \u003d tool.get(\u0027type\u0027)\n        if t \u003d\u003d \u0027function_declaration\u0027:\n            func_lines \u003d []\n            for func in tool.get(\u0027functions\u0027, []):\n                params_code \u003d schema_json_to_code(func[\u0027parameters\u0027]) if \u0027parameters\u0027 in func else \u0027None\u0027\n                func_lines.append(\n                    f\u0027genai.types.FunctionDeclaration(name\u003d{repr(func[\"name\"])},\u0027\n                    f\u0027 description\u003d{repr(func.get(\"description\", \"\"))}, parameters\u003d{params_code})\u0027\n                )\n            tool_lines.append(base_indent + f\u0027types.Tool(function_declarations\u003d[{\", \".join(func_lines)}]),\u0027)\n        elif t \u003d\u003d \u0027code_execution\u0027:\n            tool_lines.append(base_indent + \u0027types.Tool(code_execution\u003dtypes.ToolCodeExecution),\u0027)\n        elif t \u003d\u003d \u0027url_context\u0027:\n            tool_lines.append(base_indent + \u0027types.Tool(url_context\u003dtypes.UrlContext()),\u0027)\n        elif t \u003d\u003d \u0027google_search\u0027:\n            tool_lines.append(base_indent + \u0027types.Tool(google_search\u003dtypes.GoogleSearch()),\u0027)\n        else:\n            tool_lines.append(base_indent + f\u0027# Unknown tool type: {t}\u0027)\n    if tool_lines:\n        tool_lines[-1] \u003d tool_lines[-1].rstrip(\u0027,\u0027)\n    return \u0027\\n\u0027.join(tool_lines)\n\n```\n\nЧасть 3 готова:\n\n- **reconstruct_contents_list**: поддержка мультимодальных сообщений (from_bytes), from_text.\n- **reconstruct_tools_list**: поддержка function_declaration (с рекурсивной генерацией types.Schema), code_execution, url_context, google_search.\n- **schema_json_to_code**: рекурсивная генерация types.Schema(...) из JSON-схемы.\n\n---\n\n**Следующий шаг:**  \n- main_reconstruct/generate_python_chat_code: поддержка response_mime_type, response_schema_code, корректная вставка в шаблон.\n- Обновить шаблон для новых плейсхолдеров.\n- Тестирование.\n\nПродолжить?\n\n---\n\n**User**\n\nGo!\n\n---\n\n**Cursor**\n\n```python\n# ... существующий импорт ...\n\ndef generate_python_chat_code(template_path: str, variables: dict) -\u003e str:\n    \"\"\"\n    Генерирует Python-код по внешнему шаблону (template_path), подставляя значения из variables.\n    \"\"\"\n    with open(template_path, \u0027r\u0027, encoding\u003d\u0027utf-8\u0027) as f:\n        template \u003d f.read()\n    return template.format(**variables)\n\n\ndef main_reconstruct(input_json_file: str, output_py_file: str, api_key: str, model_name: str, decode_unicode: bool, template_path: str):\n    data \u003d load_json_data(input_json_file)\n    system_instruction \u003d data.get(\u0027system_instruction\u0027, \u0027\u0027)\n    dialogue_history \u003d data.get(\u0027dialogue_history\u0027, [])\n    tools_info \u003d data.get(\u0027tools_info\u0027, None)\n    response_mime_type \u003d data.get(\u0027response_mime_type\u0027, None)\n    response_schema \u003d data.get(\u0027response_schema\u0027, None)\n\n    contents_code_str \u003d reconstruct_contents_list(dialogue_history, decode_unicode\u003ddecode_unicode)\n    tools_code_str \u003d reconstruct_tools_list(tools_info)\n    api_key_repr \u003d json.dumps(api_key)\n    model_name_repr \u003d json.dumps(model_name)\n    if decode_unicode:\n        system_instruction_repr \u003d repr(system_instruction)\n    else:\n        system_instruction_repr \u003d json.dumps(system_instruction)\n    if tools_code_str and tools_code_str.strip():\n        tools_assignment_str \u003d f\"    tools \u003d [\\n{tools_code_str}\\n    ]\"\n    else:\n        tools_assignment_str \u003d \"    tools \u003d []\"\n    # response_mime_type\n    response_mime_type_str \u003d json.dumps(response_mime_type) if response_mime_type else \u0027None\u0027\n    # response_schema_code\n    response_schema_code \u003d schema_json_to_code(response_schema) if response_schema else \u0027None\u0027\n    variables \u003d {\n        \u0027api_key_repr\u0027: api_key_repr,\n        \u0027model_name_repr\u0027: model_name_repr,\n        \u0027system_instruction_repr\u0027: system_instruction_repr,\n        \u0027contents_code_str\u0027: contents_code_str,\n        \u0027tools_assignment_str\u0027: tools_assignment_str,\n        \u0027response_mime_type\u0027: response_mime_type_str,\n        \u0027response_schema_code\u0027: response_schema_code\n    }\n    code \u003d generate_python_chat_code(template_path, variables)\n    with open(output_py_file, \u0027w\u0027, encoding\u003d\u0027utf-8\u0027) as f:\n        f.write(code)\n\n\ndef cli():\n    parser \u003d argparse.ArgumentParser(description\u003d\"Reconstruct Google AI Studio chat Python code from JSON.\")\n    parser.add_argument(\u0027--input_json\u0027, type\u003dstr, required\u003dTrue, help\u003d\u0027Путь к .json файлу, сгенерированному parser.py\u0027)\n    parser.add_argument(\u0027--output_py\u0027, type\u003dstr, required\u003dTrue, help\u003d\u0027Путь для сохранения восстановленного Python-файла\u0027)\n    parser.add_argument(\u0027--api_key\u0027, type\u003dstr, required\u003dTrue, help\u003d\u0027GEMINI_API_KEY (или env:VARNAME для переменной среды)\u0027)\n    parser.add_argument(\u0027--model_name\u0027, type\u003dstr, required\u003dTrue, help\u003d\u0027MODEL_NAME (например, \"gemini-2.5-flash-preview-05-20\")\u0027)\n    parser.add_argument(\u0027--decode_unicode\u0027, action\u003d\u0027store_true\u0027, help\u003d\u0027Декодировать строки из \\\\uXXXX в символы (например, кириллицу) в выходном Python-коде\u0027)\n    parser.add_argument(\u0027--template_path\u0027, type\u003dstr, required\u003dTrue, help\u003d\u0027Путь к файлу шаблона Python-кода (.tpl)\u0027)\n    args \u003d parser.parse_args()\n    main_reconstruct(args.input_json, args.output_py, args.api_key, args.model_name, args.decode_unicode, args.template_path)\n\n\nif __name__ \u003d\u003d \"__main__\":\n    cli()\n\n```\n\n```plaintext\n# To run this code you need to install the following dependencies:\n# pip install google-genai\n\nimport base64\nimport os\nfrom google import genai\nfrom google.genai import types\n\ndef generate():\n    client \u003d genai.Client(\n        api_key\u003d{api_key_repr},\n    )\n\n    model \u003d {model_name_repr}\n    contents \u003d [\n{contents_code_str}\n    ]\n{tools_assignment_str}\n    generate_content_config \u003d types.GenerateContentConfig(\n        tools\u003dtools, \n        response_mime_type\u003d{response_mime_type},\n        response_schema\u003d{response_schema_code},\n        system_instruction\u003d[\n            types.Part.from_text(text\u003d{system_instruction_repr}),\n        ],\n    )\n\n    for chunk in client.models.generate_content_stream(\n        model\u003dmodel,\n        contents\u003dcontents,\n        config\u003dgenerate_content_config,\n    ):\n        print(chunk.text, end\u003d\"\")\n\nif __name__ \u003d\u003d \"__main__\":\n    generate()\n\n```\n\nТеперь пайплайн полностью поддерживает:\n\n- Генерацию кода с response_mime_type и response_schema (рекурсивно, для любых вложенных структур).\n- Корректную вставку этих параметров в шаблон.\n- Все типы инструментов (function_decla